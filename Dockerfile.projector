# ---- build stage ----
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/FlexCatalog.InventoryProjector/FlexCatalog.InventoryProjector.csproj src/FlexCatalog.InventoryProjector/
COPY src/FlexCatalog.Contracts/FlexCatalog.Contracts.csproj src/FlexCatalog.Contracts/
RUN dotnet restore src/FlexCatalog.InventoryProjector/FlexCatalog.InventoryProjector.csproj

COPY src/FlexCatalog.InventoryProjector/ src/FlexCatalog.InventoryProjector/
COPY src/FlexCatalog.Contracts/ src/FlexCatalog.Contracts/
RUN dotnet publish src/FlexCatalog.InventoryProjector/FlexCatalog.InventoryProjector.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

# ---- runtime stage ----
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

RUN groupadd --gid 10001 flexcatalog \
    && useradd --uid 10001 --gid flexcatalog --shell /usr/sbin/nologin --no-create-home flexcatalog

COPY --from=build /app/publish .

USER flexcatalog

ENTRYPOINT ["dotnet", "FlexCatalog.InventoryProjector.dll"]
