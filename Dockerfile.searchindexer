# ---- build stage ----
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/FlexCatalog.SearchIndexer/FlexCatalog.SearchIndexer.csproj src/FlexCatalog.SearchIndexer/
COPY src/FlexCatalog.Contracts/FlexCatalog.Contracts.csproj src/FlexCatalog.Contracts/
RUN dotnet restore src/FlexCatalog.SearchIndexer/FlexCatalog.SearchIndexer.csproj

COPY src/FlexCatalog.SearchIndexer/ src/FlexCatalog.SearchIndexer/
COPY src/FlexCatalog.Contracts/ src/FlexCatalog.Contracts/
RUN dotnet publish src/FlexCatalog.SearchIndexer/FlexCatalog.SearchIndexer.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

# ---- runtime stage ----
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

RUN groupadd --gid 10001 flexcatalog \
    && useradd --uid 10001 --gid flexcatalog --shell /usr/sbin/nologin --no-create-home flexcatalog

COPY --from=build /app/publish .

USER flexcatalog

ENTRYPOINT ["dotnet", "FlexCatalog.SearchIndexer.dll"]
